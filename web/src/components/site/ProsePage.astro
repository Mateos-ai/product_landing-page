---
// A legal/prose page body (privacy, accessibility): eyebrow, title, last-updated, lead, then titled sections.
// Reads the namespace's eyebrow, h1, updated, lead and sections[{ h, body[] }].
import type { Translator } from '../../i18n';
interface Props { t: Translator }
const { t } = Astro.props;
type Sec = { h: string; body: string[] };
const sections = t.raw<Sec[]>('sections');
---
<section class="section prose-page" data-astro-cid-psngowx4><div class="wrap prose-wrap" data-astro-cid-psngowx4><span class="eyebrow" data-astro-cid-psngowx4>{t('eyebrow')}</span><h1 class="h1" data-astro-cid-psngowx4>{t('h1')}</h1><p class="caption" data-astro-cid-psngowx4>{t('updated')}</p><p class="lead lead-lg" data-astro-cid-psngowx4>{t('lead')}</p>{sections.map((s) => (<div class="prose-sec" data-astro-cid-psngowx4><h2 class="h3" data-astro-cid-psngowx4>{s.h}</h2><div class="prose" data-astro-cid-psngowx4>{s.body.map((p) => <p data-astro-cid-psngowx4>{p}</p>)}</div></div>))}</div></section>
