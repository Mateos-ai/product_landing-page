---
// Site header: brand, main nav (with the Industries submenu), language switch, theme toggle, CTA, mobile menu.
// The data-astro-cid-* attributes are literal: assets/site.css (carried over from the v6 build) is scoped by them.
import { pageCtx } from '../../i18n/page';
import { useT, type Locale } from '../../i18n';

const { locale, route, pathname, t, u } = pageCtx(Astro);
const other: Locale = locale === 'en' ? 'he' : 'en';
const otherName = useT(other)('localeName');
type Item = { label: string; mobileLabel?: string; href: string; menu?: string; children?: Item[] };
const nav = t.raw<Item[]>('nav');
const here = route;
const isOn = (href: string, kids?: Item[]) => here === href || (href !== '/' && !href.includes('#') && here.startsWith(href)) || !!kids?.some((c) => here === c.href);
const theme = t.raw<{ title: string; light: string; dark: string }>('theme');
// The language switch points at this page's counterpart; the 404 page and the EN-only /lab/ prototypes link to the other home.
const switchHref = u(pathname.includes('404') || route.startsWith('/lab/') ? '/' : route, other);
---
<a class="skip" href="#main" data-astro-cid-3ef6ksr2>{t('skip')}</a> <header class="site-header" data-astro-cid-3ef6ksr2> <div class="wrap bar" data-astro-cid-3ef6ksr2> <a class="brand" href={u('/')} data-astro-cid-3ef6ksr2> <svg width="26" height="26" viewBox="43 43 114 114" aria-hidden="true" data-astro-cid-3ef6ksr2> <circle cx="130" cy="70" r="27" fill="#FF8C42" data-astro-cid-3ef6ksr2></circle> <circle cx="70" cy="130" r="27" fill="#17BEBB" data-astro-cid-3ef6ksr2></circle> <circle cx="130" cy="130" r="27" fill="#5B53E8" data-astro-cid-3ef6ksr2></circle> </svg> <span class="brand-name" data-astro-cid-3ef6ksr2>mateos<span class="brand-ai" data-astro-cid-3ef6ksr2>.ai</span></span> </a> <nav class="nav" aria-label={t('navLabel')} data-astro-cid-3ef6ksr2> <ul class="nav-list" data-astro-cid-3ef6ksr2> {nav.map((it) => (
<li class={it.children ? 'nav-item has-children' : 'nav-item'} data-astro-cid-3ef6ksr2> <a class={isOn(it.href, it.children) ? 'nav-link is-active' : 'nav-link'} href={u(it.href)} aria-current={here === it.href ? 'page' : undefined} data-astro-cid-3ef6ksr2>{it.label}</a> {it.children && (<Fragment><button class="nav-more" type="button" aria-expanded="false" aria-controls={`menu-${it.menu}`} aria-label={t('navMoreLabel')} data-menu={it.menu} data-astro-cid-3ef6ksr2> <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-3ef6ksr2><polyline points="6 9 12 15 18 9" data-astro-cid-3ef6ksr2></polyline></svg> </button> <ul class="nav-sub" id={`menu-${it.menu}`} data-astro-cid-3ef6ksr2> {it.children.map((c) => (<li data-astro-cid-3ef6ksr2><a class={here === c.href ? 'nav-sublink is-active' : 'nav-sublink'} href={u(c.href)} aria-current={here === c.href ? 'page' : undefined} data-astro-cid-3ef6ksr2>{c.label}</a></li>))} </ul></Fragment>)} </li>
))} </ul> </nav> <div class="bar-right" data-astro-cid-3ef6ksr2> <a class="lang" href={switchHref} lang={other} hreflang={other} data-astro-cid-3ef6ksr2>{otherName}</a> <button id="theme-toggle" class="theme-toggle" type="button" aria-pressed="false" data-title={theme.title} data-light={theme.light} data-dark={theme.dark} aria-label={theme.title} data-astro-cid-3ef6ksr2> <svg class="ico-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-3ef6ksr2><circle cx="12" cy="12" r="4" data-astro-cid-3ef6ksr2></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" data-astro-cid-3ef6ksr2></path></svg> <svg class="ico-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-3ef6ksr2><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" data-astro-cid-3ef6ksr2></path></svg> </button> <a class="btn btn-primary btn-sm nav-cta" href={u('/contact/')} data-astro-cid-3ef6ksr2>{t('cta')}</a> <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mobile-menu" aria-label={t('menu')} data-astro-cid-3ef6ksr2> <svg class="ico-menu" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-astro-cid-3ef6ksr2><path d="M4 7h16M4 12h16M4 17h16" data-astro-cid-3ef6ksr2></path></svg> <svg class="ico-close" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" data-astro-cid-3ef6ksr2><path d="M6 6l12 12M18 6L6 18" data-astro-cid-3ef6ksr2></path></svg> </button> </div> </div> <div class="mobile-menu" id="mobile-menu" hidden data-astro-cid-3ef6ksr2> <div class="wrap" data-astro-cid-3ef6ksr2> <ul class="m-list" data-astro-cid-3ef6ksr2> {nav.map((it) => (
<li data-astro-cid-3ef6ksr2> <a class={isOn(it.href, it.children) ? 'm-link is-active' : 'm-link'} href={u(it.href)} aria-current={here === it.href ? 'page' : undefined} data-astro-cid-3ef6ksr2>{it.mobileLabel ?? it.label}</a> {it.children && (<ul class="m-sub" data-astro-cid-3ef6ksr2> {it.children.map((c) => (<li data-astro-cid-3ef6ksr2><a class={here === c.href ? 'm-sublink is-active' : 'm-sublink'} href={u(c.href)} aria-current={here === c.href ? 'page' : undefined} data-astro-cid-3ef6ksr2>{c.label}</a></li>))} </ul>)} </li>
))} </ul> <a class="btn btn-primary btn-lg m-cta" href={u('/contact/')} data-astro-cid-3ef6ksr2>{t('cta')}</a> </div> </div> </header>
