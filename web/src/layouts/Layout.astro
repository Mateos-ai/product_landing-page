---
// The one layout for every page, both locales: <html lang/dir>, head metadata, header, footer.
// Props: title, description (default: common meta.defaultDescription), v7 (load the motion system; default true),
// notFound (404 head: robots noindex first, no canonical/hreflang/og:url, absolute links), ogTitle, robots,
// crumb (short page name for the BreadcrumbList; omit on home), pageType (schema.org WebPage subtype, e.g. AboutPage),
// schema (extra JSON-LD nodes for this page, e.g. Service or FAQPage).
// Slots: default -> <main>, "head" -> end of <head> metadata (before the inline scripts), "head-end" -> just before </head>
// (after every script, e.g. the contact page's xray-done-css), "after-footer" -> after </footer>.
import Header from '../components/site/Header.astro';
import Footer from '../components/site/Footer.astro';
import { pageCtx } from '../i18n/page';
import { LOCALE_META, LOCALES, absUrl, useT } from '../i18n';
import antiFlash from '../scripts/anti-flash.js?raw';
import v7Gate from '../scripts/v7-gate.js?raw';
import siteJs from '../scripts/site.js?raw';

interface Props {
  title: string;
  description?: string;
  ogTitle?: string;
  robots?: string;
  v7?: boolean;
  notFound?: boolean;
  crumb?: string;
  pageType?: string;
  schema?: Record<string, unknown>[];
}
const { locale, route, t, asset } = pageCtx(Astro);
const meta = LOCALE_META[locale];
const p = Astro.props;
const description = p.description ?? t('meta.defaultDescription');
const ogTitle = p.ogTitle ?? p.title;
const robots = p.robots ?? (t.has('meta.robots') ? t('meta.robots') : undefined);
const v7 = p.v7 ?? true;
const notFound = !!p.notFound;
// The /lab/ prototypes are EN only: no hreflang alternates pointing at /he/lab/ (which does not exist).
const lab = route.startsWith('/lab/');
// hreflang only between indexable versions: a locale with a site-wide meta.robots (Hebrew, while it is noindex) gets none,
// so Search Console sees no alternates pointing at noindexed pages. Removing he/common.json meta.robots turns them back on.
const hreflang = !lab && LOCALES.every((l) => !useT(l, 'common').has('meta.robots'));
// Structured data: one @graph per page. Organization and WebSite are the same on every page (same @id), the WebPage
// and BreadcrumbList describe this page, and views add their own nodes (Service, FAQPage) through `schema`.
const SITE = 'https://mateos.ai';
const pageUrl = absUrl(locale, route);
const homeUrl = absUrl(locale, '/');
const graph: Record<string, unknown>[] = [
  { '@type': 'Organization', '@id': `${SITE}/#org`, name: 'Mateos', url: `${SITE}/`, logo: { '@type': 'ImageObject', url: `${SITE}/logo.png`, width: 1028, height: 1028 }, description: t('meta.defaultDescription'), sameAs: ['https://www.linkedin.com/company/mateos-ai'] },
  { '@type': 'WebSite', '@id': `${SITE}/#website`, name: 'Mateos', url: `${SITE}/`, publisher: { '@id': `${SITE}/#org` }, inLanguage: ['en', 'he'] },
];
if (!notFound) {
  graph.push({ '@type': p.pageType ?? 'WebPage', '@id': `${pageUrl}#webpage`, url: pageUrl, name: p.title, description, inLanguage: meta.lang, isPartOf: { '@id': `${SITE}/#website` }, about: { '@id': `${SITE}/#org` }, primaryImageOfPage: { '@type': 'ImageObject', url: t('meta.ogImage') } });
  if (p.crumb && route !== '/') graph.push({ '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: t('meta.siteName'), item: homeUrl },
    { '@type': 'ListItem', position: 2, name: p.crumb, item: pageUrl },
  ] });
}
if (p.schema) graph.push(...p.schema);
// </ inside a JSON string would close the <script>; \u003c keeps the JSON identical once parsed.
const ld = JSON.stringify({ '@context': 'https://schema.org', '@graph': graph }).replace(/</g, '\\u003c');
---
<html lang={meta.lang} dir={meta.dir}> <head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>{p.title}</title>{notFound && robots && <meta name="robots" content={robots}>}<meta name="description" content={description}>{!notFound && (<Fragment><link rel="canonical" href={absUrl(locale, route)}>{hreflang && <Fragment><link rel="alternate" hreflang="en" href={absUrl('en', route)}><link rel="alternate" hreflang="he" href={absUrl('he', route)}><link rel="alternate" hreflang="x-default" href={absUrl('en', route)}></Fragment>}{robots && <meta name="robots" content={robots}>}</Fragment>)}<meta name="theme-color" content="#14141E"><!-- Open Graph --><meta property="og:type" content="website"><meta property="og:site_name" content={t('meta.siteName')}><meta property="og:locale" content={meta.og}>{!notFound && <meta property="og:url" content={absUrl(locale, route)}>}<meta property="og:title" content={ogTitle}><meta property="og:description" content={description}><meta property="og:image" content={t('meta.ogImage')}><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630"><meta property="og:image:type" content="image/png"><meta property="og:image:alt" content={t('meta.ogImageAlt')}><!-- Twitter --><meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content={ogTitle}><meta name="twitter:description" content={description}><meta name="twitter:image" content={t('meta.ogImage')}><link rel="icon" type="image/svg+xml" href={asset('favicon.svg')}><link rel="icon" href={asset('favicon.ico')} sizes="any"><script type="application/ld+json" is:inline set:html={ld}></script><slot name="head" /><!-- Anti-flash: apply the stored theme before first paint. --><script is:inline set:html={antiFlash}></script>{v7 && <script is:inline set:html={v7Gate}></script>}<link rel="stylesheet" href={asset('assets/site.css')}>{v7 && <link rel="stylesheet" href={asset('assets/v7.css')}>}<script type="module" is:inline set:html={siteJs}></script>{v7 && <script src={asset('assets/v7.js')} defer is:inline></script>}<slot name="head-end" /></head> <body>  <Header />   <main id="main">
<slot />
</main> <Footer />    <slot name="after-footer" /></body> </html>
