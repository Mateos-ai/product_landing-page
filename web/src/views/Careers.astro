---
// Careers page (/careers/ and /he/careers/). Copy: src/i18n/<locale>/careers.json. Not a v7 page.
import Layout from '../layouts/Layout.astro';
import { pageCtx } from '../i18n/page';

const { t, u } = pageCtx(Astro, 'careers');
type Role = { title: string; where: string; body: string[]; apply: string };
const roles = t.raw<Role[]>('open.roles');
---
<Layout title={t('meta.title')} description={t('meta.description')} v7={false}>
<section class="pagehead" data-astro-cid-psngowx4><div class="wrap" data-astro-cid-psngowx4><span class="eyebrow" data-astro-cid-psngowx4>{t('head.eyebrow')}</span><h1 class="h1" data-astro-cid-psngowx4>{t('head.h1')}</h1><p class="lead lead-lg" data-astro-cid-psngowx4>{t('head.lead')}</p></div></section><section class="section subtle" data-astro-cid-psngowx4><div class="wrap" data-astro-cid-psngowx4><span class="eyebrow" data-astro-cid-psngowx4>{t('open.eyebrow')}</span><h2 class="h2" data-astro-cid-psngowx4>{t('open.title')}</h2><p class="lead" data-astro-cid-psngowx4>{t('open.lead')}</p><div class="roles" data-astro-cid-psngowx4>{roles.map((r) => (<article class="role-card" data-astro-cid-psngowx4><h3 data-astro-cid-psngowx4>{r.title}</h3><p class="role" data-astro-cid-psngowx4>{r.where}</p><div class="prose" data-astro-cid-psngowx4>{r.body.map((p) => <p data-astro-cid-psngowx4>{p}</p>)}</div><p class="apply" data-astro-cid-psngowx4>{r.apply}</p></article>))}</div><p class="caption" data-astro-cid-psngowx4>{t('open.note')}</p></div></section><section class="section dark cta" id="start" data-astro-cid-psngowx4><div class="wrap cta-inner" data-astro-cid-psngowx4><span class="eyebrow" data-astro-cid-psngowx4>{t('cta.eyebrow')}</span><h2 class="h2" data-astro-cid-psngowx4>{t('cta.title')}</h2><p class="lead" data-astro-cid-psngowx4>{t('cta.lead')}</p><div class="actions" data-astro-cid-psngowx4><a class="btn btn-primary btn-lg" href={u('/contact/')} data-astro-cid-psngowx4>{t('cta.primary')}</a><a class="btn btn-ghost btn-lg" href={u('/contact/')} data-astro-cid-psngowx4>{t('cta.secondary')}</a></div></div></section>
</Layout>
