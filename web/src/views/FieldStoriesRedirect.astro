---
// /field-stories/ and /he/field-stories/: the old Field stories page moved to the industry pages.
// A tiny standalone document (no Layout) that redirects to Industries. Copy: src/i18n/<locale>/field-stories.json.
import { pageCtx } from '../i18n/page';
import { LOCALE_META, absUrl } from '../i18n';

const { locale, t } = pageCtx(Astro, 'field-stories');
const m = LOCALE_META[locale];
// Same relative target as the live pages for both locales (/field-stories/ -> /industries/, /he/field-stories/ -> /he/industries/).
const target = '../industries/';
---
<!DOCTYPE html>
<html lang={m.lang} dir={m.dir}>
<head>
<meta charset="utf-8">
<title>{t('title')}</title>
<meta name="robots" content="noindex">
<link rel="canonical" href={absUrl(locale, '/industries/')}>
<meta http-equiv="refresh" content={`0; url=${target}`}>
</head>
<body>
<p>{t('body')} <a href={target}>{t('link')}</a>.</p>
</body>
</html>
