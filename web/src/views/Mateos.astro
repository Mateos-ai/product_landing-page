---
// MateOS product page (/mateos/ and /he/mateos/). Copy: src/i18n/<locale>/mateos.json.
// Previews: M10 (hero, in the M0 shell), M15, T1 tour (M3 M4 M5 M6 M8 M9), M11, M12, M13 (in the M0 shell).
import Layout from '../layouts/Layout.astro';
import Check from '../components/site/Check.astro';
import Sprite from '../components/v7/Sprite.astro';
import M10 from '../components/v7/M10.astro';
import M11 from '../components/v7/M11.astro';
import M12 from '../components/v7/M12.astro';
import M13 from '../components/v7/M13.astro';
import M15 from '../components/v7/M15.astro';
import ProductTour from '../components/v7/ProductTour.astro';
import Arrow from '../components/site/Arrow.astro';
import { caption } from '../v7/fragments';
import { pageCtx } from '../i18n/page';
import { curly } from '../i18n';

const { locale, t, u } = pageCtx(Astro, 'mateos');
const h1 = t.raw<string[]>('hero.h1');
const surfaces = t.raw<string[]>('surfaces.title');
const facts = t.raw<[string, string][]>('control.facts');
const qs = t.raw<[string, string][]>('faq.qs');
const startTitle = t.raw<string[]>('start.title');
const leads = t.raw<string[]>('start.leads');
---
<Layout title={t('meta.title')} description={t('meta.description')}>
<Sprite />

<section class="v7-band-dark v7-hero v7-hero--center v7-pp-hero" id="top" aria-labelledby="hero-h1">
  <div class="v7-wrap">
    <div class="v7-pp-hcopy">
         <h1 id="hero-h1" class="v7-h1" data-v7-reveal="mask" data-v7-delay="80"><span class="v7-line"><span set:html={h1[0]} /></span><span class="v7-line v7-pp-ok"><span set:html={h1[1]} /></span></h1>
      <p class="v7-lead" data-v7-reveal data-v7-delay="300" set:html={t('hero.lead')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="380"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('hero.cta')} /><a class="btn btn-lg v7-btn-ghost" href="#tour" set:html={t('hero.tour')} /></div>
    </div>
<M10 figClass="v7-pp-hfig" figAttrs='data-v7-reveal="rise" data-v7-delay="400"' cap={curly(caption('M10', locale), locale)} pause newlineScreens />
  </div>
</section>

<section class="v7-sec v7-pp-sec" id="backwards" aria-labelledby="backwards-h">
  <div class="v7-wrap v7-pp-split v7-pp-split--tree">
    <h2 id="backwards-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('backwards.title')} /></span></h2>
    <div class="v7-pp-copy">
      <p class="v7-lead" data-v7-reveal set:html={t('backwards.lead')} />
      <div class="v7-pp-toggle" data-v7-reveal data-v7-delay="80">
        <div class="m-tree-toggle" role="group" aria-label={t('backwards.toggleLabel')}>
          <button type="button" data-mode="old" aria-pressed="false" set:html={t('backwards.old')} />
          <button type="button" data-mode="new" aria-pressed="true" set:html={t('backwards.new')} />
        </div>
      </div>
    </div>
<M15 attrs='data-v7-reveal="rise" data-v7-delay="120"' />
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-pp-sec v7-pp-tour" id="tour" aria-labelledby="tour-h">
  <div class="v7-wrap-wide">
    <div class="v7-pp-center">
      <h2 id="tour-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('tour.title')} /></span></h2>
      <p class="v7-note" data-v7-reveal data-v7-delay="120" set:html={t('tour.note')} />
    </div>
<ProductTour cap={t('tour.cap')} />
  </div>
</section>

<section class="v7-sec v7-pp-sec" id="surfaces" aria-labelledby="surfaces-h">
  <div class="v7-wrap">
    <div class="v7-pp-center">
      <h2 id="surfaces-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={surfaces[0]} /></span><span class="v7-line"><span set:html={surfaces[1]} /></span></h2>
      <p class="v7-lead" data-v7-reveal data-v7-delay="120" set:html={t('surfaces.lead')} />
    </div>
<M11 attrs='data-v7-reveal="rise" data-v7-delay="200"' />
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-pp-sec" id="loop" aria-labelledby="loop-h">
  <div class="v7-wrap">
    <div class="v7-pp-center">
      <h2 id="loop-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('loop.title')} /></span></h2>
      <p class="v7-lead" data-v7-reveal data-v7-delay="120" set:html={t('loop.lead')} />
    </div>
<M12 attrs='data-v7-reveal="rise" data-v7-delay="200"' />
  </div>
</section>

<section class="v7-sec v7-pp-sec" id="control" aria-labelledby="control-h">
  <div class="v7-wrap v7-pp-split v7-pp-split--ctrl">
    <div class="v7-pp-copy">
      <h2 id="control-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('control.title')} /></span></h2>
      <ul class="v7-facts" data-v7-stagger="80" data-v7-delay="120">
        {facts.map(([title, line]) => (
        <Fragment><li data-v7-reveal><Check focusable /><div><strong set:html={title} /><span set:html={line} /></div></li>{'\n'}</Fragment>
        ))}
      </ul>
      <a class="v7-link-arrow" href={u('/security-and-control/')} data-v7-reveal><Fragment set:html={t('control.more')} /><Arrow /></a>
    </div>
<M13 figClass="v7-pp-cfig" figAttrs='data-v7-reveal="rise" data-v7-delay="120"' cap={curly(caption('M13', locale), locale)} pause newlineScreens />
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-pp-sec" id="faq" aria-labelledby="faq-h">
  <div class="v7-wrap v7-pp-faq">
    <h2 id="faq-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('faq.title')} /></span></h2>
    <div class="v7-pp-qs" data-v7-stagger="80">
      {qs.map(([q, a], i) => (
      <details class="v7-pp-q" open={i === 0} data-v7-reveal>
        <summary><Fragment set:html={q} /><span class="v7-pp-plus" aria-hidden="true"></span></summary>
        <p set:html={a} />
      </details>
      ))}
    </div>
  </div>
</section>

<section class="v7-sec v7-band-dark v7-cta v7-pp-cta" id="start" aria-labelledby="start-h">
  <div class="v7-wrap">
    <div class="v7-pp-ctacopy" data-v7-stagger="80">
      <h2 id="start-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={startTitle[0]} /></span> <span class="v7-line"><span set:html={startTitle[1]} /></span></h2>
      {leads.map((l) => <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={l} />)}
      <p class="v7-fine" data-v7-reveal data-v7-delay="160" set:html={t('start.fine')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="160"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('common:connect')} /></div>
    </div>
  </div>
</section>
</Layout>
