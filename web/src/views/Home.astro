---
// Home page (/ and /he/). Copy: src/i18n/<locale>/home.json. Previews: M1 (hero), K2, M3/M4/M5 in the M0 shell, M7.
import Layout from '../layouts/Layout.astro';
import Sprite from '../components/v7/Sprite.astro';
import M1 from '../components/v7/M1.astro';
import K2 from '../components/v7/K2.astro';
import M0 from '../components/v7/M0.astro';
import M7 from '../components/v7/M7.astro';
import Arrow from '../components/site/Arrow.astro';
import Check from '../components/site/Check.astro';
import { pageCtx } from '../i18n/page';

const { t, u } = pageCtx(Astro, 'home');
type Step = { label: string; sents?: string[]; h3?: string; p?: string };
type Rung = { name: string; tag?: string; body: string };
const h1 = t.raw<string[]>('hero.h1');
const steps = t.raw<Step[]>('how.steps');
const HOW = [{ id: 'M3', tone: 'you' }, { id: 'M4', tone: 'mate' }, { id: 'M5', tone: 'ok' }];
const checks = t.raw<string[]>('control.checks');
const startTitle = t.raw<string[]>('start.title');
const ladder = t.raw<Rung[]>('start.ladder');
---
<Layout title={t('meta.title')} description={t('meta.description')}>
<Sprite />

<section class="v7-band-dark v7-hero v7-home-hero v7-home-front" id="top" aria-labelledby="hero-h1">
  <div class="v7-wrap-wide v7-hero-grid">
    <div class="v7-hero-copy">
      <h1 id="hero-h1" class="v7-h1" data-v7-reveal="mask" data-v7-delay="80"><span class="v7-line"><span set:html={h1[0]} /></span> <span class="v7-line"><span set:html={h1[1]} /></span></h1>
      <ol class="v7-stepper" data-v7-stagger="80" data-v7-delay="320">
        {(['goal', 'flows', 'track'] as const).map((k) => (
        <Fragment><li data-stage={k} data-v7-reveal><span class="v7-stepper-dot"></span><span class="v7-stepper-t" set:html={t(`hero.steps.${k}`)} /></li>{'\n'}</Fragment>
        ))}
      </ol>
      <div class="v7-actions" data-v7-reveal data-v7-delay="560"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('hero.cta')} /><a class="btn btn-lg v7-btn-ghost" href={u('/mateos/#tour')} set:html={t('hero.tour')} /></div>
      <p class="v7-micro" data-v7-reveal="fade" data-v7-delay="640" set:html={t('hero.micro')} />
    </div>
<M1 indent={4} />
  </div>
</section>

<section class="v7-sec v7-home-rev" id="reverse" aria-labelledby="reverse-h">
  <div class="v7-wrap">
    <h2 class="v7-h2" id="reverse-h" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('reverse.title')} /></span></h2>
    <p class="v7-lead" data-v7-reveal data-v7-delay="120" set:html={t('reverse.lead')} />
<K2 indent={4} />
    <a class="v7-link-arrow v7-k2-more" href={u('/mateos/')} data-v7-reveal><Fragment set:html={t('reverse.more')} /><Arrow /></a>
  </div>
</section>

<section class="v7-sec v7-sec--subtle" id="how" aria-labelledby="how-h">
  <div class="v7-wrap-wide v7-how" data-v7-steps>
    <h2 id="how-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('how.title')} /></span></h2>
    {steps.map((s, i) => (<Fragment>
    <div class="v7-how-step" data-step={i + 1} data-v7-reveal>
      <p class="v7-label"><i data-tone={HOW[i].tone}></i><Fragment set:html={s.label} /></p>
      {s.sents
        ? <h3 class="v7-h3"><span class="v7-sent" set:html={s.sents[0]} /> <span class="v7-sent" set:html={s.sents[1]} /></h3>
        : <h3 class="v7-h3" set:html={s.h3} />}
      {s.p && <p class="v7-how-p" set:html={s.p} />}
    </div>
<M0 screens={[HOW[i].id]} figClass="v7-how-win" preAttrs={`data-step="${i + 1}"`} indent={4} />
    </Fragment>))}
    <span class="v7-how-rail" aria-hidden="true"><i></i></span>
  </div>
</section>

<section class="v7-sec" id="control" aria-labelledby="control-h">
  <div class="v7-wrap v7-home-split">
    <div class="v7-home-copy" data-v7-stagger="80">
      <h2 class="v7-h2" id="control-h" data-v7-reveal set:html={t('control.title')} />
      <p class="v7-lead" data-v7-reveal set:html={t('control.lead')} />
      <ul class="v7-check-list" data-v7-stagger="80" data-v7-delay="240">
        {checks.map((c) => (
        <Fragment><li data-v7-reveal><Check /><Fragment set:html={c} /></li>{'\n'}</Fragment>
        ))}
      </ul>
      <a class="v7-link-arrow" href={u('/security-and-control/')} data-v7-reveal data-v7-delay="480"><Fragment set:html={t('control.link')} /><Arrow /></a>
    </div>
<M7 indent={4} />
  </div>
</section>

<section class="v7-sec v7-band-dark v7-cta" id="start" aria-labelledby="start-h">
  <div class="v7-wrap v7-home-cta">
    <div class="v7-home-cta-copy">
      <h2 class="v7-h2" id="start-h" data-v7-reveal="mask"><span class="v7-line"><span set:html={startTitle[0]} /></span> <span class="v7-line"><span set:html={startTitle[1]} /></span></h2>
      <ol class="v7-ladder">
        {ladder.map((r) => (<Fragment>
        <li><h3 class="v7-ladder-name"><Fragment set:html={r.name} />{r.tag && <Fragment> <span class="v7-ladder-tag" set:html={r.tag} /></Fragment>}</h3><p class="v7-ladder-body" set:html={r.body} /></li>{'\n'}</Fragment>
        ))}
      </ol>
      <p class="v7-fine" data-v7-reveal set:html={t('start.fine')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="80"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('common:connect')} /></div>
    </div>
  </div>
</section>
</Layout>
