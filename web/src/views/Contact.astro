---
// Contact page (/contact/ and /he/contact/): the X-ray form (Web3Forms, submitted by src/scripts/site.js),
// the animated success panel (src/scripts/xray-done.js, src/styles/xray-done.css) and the FAQ. Copy: src/i18n/<locale>/contact.json.
// Not a v7 page: no gate, v7.css or v7.js. The data-astro-cid-psngowx4 attributes scope the site.css styles.
import Layout from '../layouts/Layout.astro';
import { pageCtx } from '../i18n/page';
import xrayDone from '../scripts/xray-done.js?raw';
import xrayDoneCss from '../styles/xray-done.css?raw';

const { t } = pageCtx(Astro, 'contact');
// Web3Forms access key: public by design (it only allows posting to our inbox).
const WEB3FORMS_KEY = 'aeb02558-29a9-4c94-a253-8b9594ee9bcc';
type Card = { h: string; p: string };
type Qa = { q: string; a: string };
// The success check art, as a string so the self-closing SVG tags ship exactly as on the live page.
const ART = '<svg viewBox="0 0 96 96" aria-hidden="true" focusable="false"><defs><linearGradient id="xd-grad" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#FF8C42"/><stop offset=".52" stop-color="#17BEBB"/><stop offset="1" stop-color="#5B53E8"/></linearGradient></defs><circle class="xd-ring" cx="48" cy="48" r="38" fill="none" stroke="url(#xd-grad)" stroke-width="5" stroke-linecap="round" pathLength="1"/><path class="xd-check" d="M31 49 L43 61 L66 36" fill="none" stroke="#17BEBB" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round" pathLength="1"/><circle class="xd-dot d1" cx="82" cy="14" r="6" fill="#FF8C42"/><circle class="xd-dot d2" cx="88" cy="30" r="5" fill="#17BEBB"/><circle class="xd-dot d3" cx="74" cy="4" r="4" fill="#5B53E8"/></svg>';
const cards = t.raw<Card[]>('cards');
const faq = t.raw<Qa[]>('faq.items');
---
<Layout title={t('meta.title')} description={t('meta.description')} v7={false}>
<section class="section contact-sec" data-astro-cid-psngowx4><div class="wrap contact-grid" data-astro-cid-psngowx4><div data-astro-cid-psngowx4><span class="eyebrow" data-astro-cid-psngowx4>{t('eyebrow')}</span><h1 class="h1" data-astro-cid-psngowx4>{t('h1')}</h1><p class="lead lead-lg" data-astro-cid-psngowx4>{t('lead')}</p><div class="contact-cards" data-astro-cid-psngowx4>{cards.map((c, i) => (<div class="ccard" data-astro-cid-psngowx4><h2 class="h4" data-astro-cid-psngowx4>{c.h}</h2><p data-astro-cid-psngowx4>{c.p}</p>{i === 0 && <a class="link-plain" href="mailto:hello@mateos.ai" data-astro-cid-psngowx4>hello@mateos.ai</a>}</div>))}</div></div><div class="form-card" data-astro-cid-psngowx4><h2 class="h3" data-astro-cid-psngowx4>{t('form.title')}</h2><p class="form-lead" data-astro-cid-psngowx4>{t('form.lead')}</p><form class="xray-form" id="xray-form" novalidate data-key={WEB3FORMS_KEY} data-sending={t('form.sending')} data-retry={t('form.retry')} data-button={t('form.button')} data-astro-cid-psngowx4><div class="field" data-astro-cid-psngowx4><label for="xray-email" data-astro-cid-psngowx4>{t('form.labels.email')}</label><input id="xray-email" name="email" type="email" required autocomplete="email" inputmode="email" data-astro-cid-psngowx4></div><div class="field" data-astro-cid-psngowx4><label for="xray-company" data-astro-cid-psngowx4>{t('form.labels.company')}</label><input id="xray-company" name="company" type="text" required autocomplete="organization" data-astro-cid-psngowx4></div><div class="field" data-astro-cid-psngowx4><label for="xray-note" data-astro-cid-psngowx4>{t('form.labels.note')}</label><textarea id="xray-note" name="note" rows="3" data-astro-cid-psngowx4></textarea></div><input type="checkbox" name="botcheck" class="sr-only" tabindex="-1" aria-hidden="true" data-astro-cid-psngowx4><button type="submit" class="btn btn-primary btn-lg" data-astro-cid-psngowx4>{t('form.submit')}</button><div class="form-msg xray-done" id="form-success" role="status" tabindex="-1" hidden><div class="xray-done-art" set:html={ART} /><p class="xray-done-h">{t('form.success.h')}</p><p class="xray-done-p" set:html={t('form.success.p')} /><button type="button" class="btn btn-ghost xray-again">{t('form.success.again')}</button></div><p class="form-msg is-error" id="form-error" role="alert" hidden data-astro-cid-psngowx4>{t('form.error')}</p></form></div></div></section><section class="section subtle" data-astro-cid-psngowx4><div class="wrap faq-wrap" data-astro-cid-psngowx4><div data-astro-cid-psngowx4><span class="eyebrow" data-astro-cid-psngowx4>{t('faq.eyebrow')}</span><h2 class="h2" data-astro-cid-psngowx4>{t('faq.title')}</h2></div><div class="faq" data-astro-cid-psngowx4>{faq.map((f) => (<details class="faq-item" data-astro-cid-psngowx4><summary data-astro-cid-psngowx4>{f.q}<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" data-astro-cid-psngowx4><polyline points="6 9 12 15 18 9" data-astro-cid-psngowx4></polyline></svg></summary><p data-astro-cid-psngowx4>{f.a}</p></details>))}</div></div></section>
<style is:inline id="xray-done-css" slot="head-end" set:html={xrayDoneCss}></style>
<script is:inline id="xray-done-js" slot="after-footer" set:html={xrayDone}></script>
</Layout>
