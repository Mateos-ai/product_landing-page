---
// The Process page (/how-we-work/ and /he/how-we-work/). Copy: src/i18n/<locale>/how-we-work.json.
// Previews: M19 (hero), M14, M20; the HWW-N number card is page markup (P-HWW.js animates it).
import Layout from '../layouts/Layout.astro';
import Sprite from '../components/v7/Sprite.astro';
import M14 from '../components/v7/M14.astro';
import M19 from '../components/v7/M19.astro';
import M20 from '../components/v7/M20.astro';
import Arrow from '../components/site/Arrow.astro';
import { pageCtx } from '../i18n/page';

const { t, u } = pageCtx(Astro, 'how-we-work');
type Stop = { name: string; tag: string; line: string; weeksLabel?: string; weeks?: string[] };
const h1 = t.raw<string[]>('hero.h1');
const stops = t.raw<Stop[]>('steps.stops');
// h2 made of v7-line spans; the Hebrew pages put a space between the lines (titleSep)
const lines = (key: string) =>
  t.raw<string[]>(`${key}.title`).map((s) => `<span class="v7-line"><span>${s}</span></span>`).join(t(`${key}.titleSep`));
// hero h1: five lines; the decorative row breaks after lines 2, 3 and 4 (the one after 3 is narrow); the last two are highlighted
const ROW = ['', '<span class="v7-hww-row" aria-hidden="true"></span>', '<span class="v7-hww-row v7-hww-row--xs" aria-hidden="true"></span>', '<span class="v7-hww-row" aria-hidden="true"></span>', ''];
const h1Html = h1.map((s, i) => `<span class="v7-line${i >= 3 ? ' v7-hww-hl' : ''}" style="--v7-li:${i}"><span>${s}</span></span>${ROW[i]}`).join(' ');
const STOP_TONE = ['you', 'mate', 'ok'];
const n = (k: string) => t(`measure.num.${k}`);
---
<Layout title={t('meta.title')} description={t('meta.description')}>
<Sprite />

<section class="v7-band-dark v7-hero v7-home-hero v7-hww-hero" id="top" aria-labelledby="hero-h1">
  <div class="v7-wrap-wide v7-hero-grid">
    <div class="v7-hero-copy">
      <span class="eyebrow" data-v7-reveal set:html={t('hero.eyebrow')} />
      <h1 id="hero-h1" class="v7-h1" data-v7-reveal="mask" data-v7-delay="80" set:html={h1Html} />
      <p class="v7-lead" data-v7-reveal data-v7-delay="320" set:html={t('hero.lead')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="400"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('hero.cta')} /><a class="btn btn-lg v7-btn-ghost" href={u('/contact/')} set:html={t('hero.contact')} /></div>
      <p class="v7-micro" data-v7-reveal="fade" data-v7-delay="480" set:html={t('hero.micro')} />
    </div>
<M19 indent={4} />
  </div>
</section>

<section class="v7-sec v7-hww-sec" id="xray" aria-labelledby="xray-h">
  <div class="v7-wrap v7-hww-split">
    <div class="v7-hww-copy" data-v7-stagger="80">
      <span class="eyebrow" data-v7-reveal set:html={t('xray.eyebrow')} />
      <h2 class="v7-h2" id="xray-h" data-v7-reveal="mask" data-v7-delay="80" set:html={lines('xray')} />
      <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={t('xray.lead')} />
    </div>
<M14 indent={4} />
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-hww-sec" id="build" aria-labelledby="build-h">
  <div class="v7-wrap v7-hww-split v7-hww-split--flip">
    <div class="v7-hww-copy" data-v7-stagger="80">
      <span class="eyebrow" data-v7-reveal set:html={t('build.eyebrow')} />
      <h2 class="v7-h2" id="build-h" data-v7-reveal="mask" data-v7-delay="80"><span class="v7-line"><span set:html={t('build.title')} /></span></h2>
      <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={t('build.lead')} />
      <a class="v7-link-arrow" href={u('/security-and-control/')} data-v7-reveal data-v7-delay="240"><Fragment set:html={t('build.more')} /><Arrow /></a>
    </div>
<M20 indent={4} />
  </div>
</section>

<section class="v7-sec v7-hww-sec" id="steps" aria-labelledby="steps-h">
  <div class="v7-wrap">
    <span class="eyebrow" data-v7-reveal set:html={t('steps.eyebrow')} />
    <h2 class="v7-h2 v7-hww-steps-h" id="steps-h" data-v7-reveal="mask" data-v7-delay="80" set:html={lines('steps')} />
    <ol class="v7-hww-track">
      {stops.map((s, i) => (
      <li class="v7-hww-stop" data-tone={STOP_TONE[i]}>
        <span class="v7-hww-dot" aria-hidden="true"></span>
        <div class="v7-hww-card">
          <div class="v7-hww-head"><h3 class="v7-hww-name" set:html={s.name} /><span class="v7-hww-tag" set:html={s.tag} /></div>
          <p class="v7-hww-line" set:html={s.line} />
          {i === 0 && <span class="v7-hww-art v7-hww-rank" aria-hidden="true"><i style="--w:1"></i><i style="--w:.72"></i><i style="--w:.48"></i></span>}
          {i === 1 && s.weeks && (
          <div class="v7-hww-art v7-hww-weeks" role="img" aria-label={s.weeksLabel}>
            <span class="v7-hww-cells"><i data-tone="mate"></i><i data-tone="you"></i><i data-tone="you"></i><i data-tone="ok"></i></span>
            <span class="v7-hww-wl" data-at="1" set:html={s.weeks[0]} /><span class="v7-hww-wl" data-at="2" set:html={s.weeks[1]} /><span class="v7-hww-wl" data-at="4" set:html={s.weeks[2]} />
          </div>
          )}
          {i === 2 && <span class="v7-hww-art v7-hww-lanes" aria-hidden="true"><span><i data-tone="ok"></i><i data-tone="mate"></i><i></i></span><span><i data-tone="ok"></i><i data-tone="mate"></i><i></i></span></span>}
        </div>
      </li>
      ))}
    </ol>
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-hww-sec" id="measure" aria-labelledby="measure-h">
  <div class="v7-wrap v7-hww-split">
    <div class="v7-hww-copy" data-v7-stagger="80">
      <span class="eyebrow" data-v7-reveal set:html={t('measure.eyebrow')} />
      <h2 class="v7-h2" id="measure-h" data-v7-reveal="mask" data-v7-delay="80"><span class="v7-line"><span set:html={t('measure.title')} /></span></h2>
      <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={t('measure.lead')} />
      <p class="v7-hww-fine" data-v7-reveal data-v7-delay="240" set:html={t('measure.fine')} />
    </div>
    <figure class="v7-figure v7-hww-numfig">
      <div class="v7-mock v7-hww-num" data-v7-mock="HWW-N" data-v7-play="once" data-v7-threshold=".4" aria-hidden="true" inert>
        <div class="v7-hww-num-head">
          <p class="v7-hww-num-title"><Fragment set:html={'<svg class="v7-ic"><use href="#i-goal"/></svg>'} /><Fragment set:html={n('title')} /></p>
          <span class="v7-preview-tag" set:html={n('tag')} />
        </div>
        <dl class="v7-hww-num-cols" dir="ltr">
          <div><dt set:html={n('baseline')} /><dd class="v7-hww-num-v">6%</dd></div>
          <div class="is-now"><dt set:html={n('today')} /><dd class="v7-hww-num-v v7-hww-num-now">51%</dd></div>
          <div><dt set:html={n('target')} /><dd class="v7-hww-num-v">90%</dd></div>
        </dl>
        <span class="v7-bar v7-hww-num-bar" data-tone="ok" dir="ltr"><i class="v7-bar-fill" style="--v:.51"></i><i class="v7-bar-tick" style="--at:.06"></i><i class="v7-bar-flag" style="--at:.9"><b set:html={n('flag')} /></i></span>
        <p class="v7-hww-num-cap"><span set:html={n('week')} /><span class="v7-hww-num-ok" set:html={n('ok')} /></p>
      </div>
      <figcaption class="sr-only" set:html={n('cap')} />
    </figure>
  </div>
</section>

<section class="v7-sec v7-band-dark v7-cta v7-pp-cta v7-hww-cta" id="start" aria-labelledby="start-h">
  <div class="v7-wrap">
    <div class="v7-pp-ctacopy" data-v7-stagger="80">
      <h2 id="start-h" class="v7-h2" data-v7-reveal="mask" set:html={lines('start')} />
      <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={t('start.lead')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="160"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('common:connect')} /></div>
    </div>
  </div>
</section>
</Layout>
