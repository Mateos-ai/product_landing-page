---
// Security and control (/security-and-control/ and /he/security-and-control/). Copy: src/i18n/<locale>/security.json.
// Previews: M21 (hero, data boundary) and M20 (agreement card).
import Layout from '../layouts/Layout.astro';
import Check from '../components/site/Check.astro';
import Sprite from '../components/v7/Sprite.astro';
import M21 from '../components/v7/M21.astro';
import M20 from '../components/v7/M20.astro';
import Arrow from '../components/site/Arrow.astro';
import { pageCtx } from '../i18n/page';

const { t, u } = pageCtx(Astro, 'security');
type Card = { t: string; p: string };
type Row = { t: string; who: string; what: string };
const h1 = t.raw<string[]>('hero.h1');
const cards = t.raw<Card[]>('touch.cards');
const fields = t.raw<string[]>('touch.fields');
const log = t.raw<Row[]>('touch.log');
const checks = t.raw<string[]>('privacy.checks');
const startTitle = t.raw<string[]>('start.title');
const mailto = `mailto:hello@mateos.ai?subject=${t('questionnaireSubject')}`;
const logDir = t('touch.logDir') || undefined;
const FIELD_W = ['.92', '.6', '.78'];
---
<Layout title={t('meta.title')} description={t('meta.description')}>
<Sprite />

<section class="v7-band-dark v7-hero v7-home-hero v7-sec-hero" id="top" aria-labelledby="hero-h1">
  <div class="v7-wrap-wide v7-hero-grid">
    <div class="v7-hero-copy">
      <span class="eyebrow" data-v7-reveal set:html={t('hero.eyebrow')} />
      <h1 id="hero-h1" class="v7-h1" data-v7-reveal="mask" data-v7-delay="80"><span class="v7-line"><span set:html={h1[0]} /></span><span class="v7-line"><span set:html={h1[1]} /></span></h1>
      <p class="v7-lead" data-v7-reveal data-v7-delay="240" set:html={t('hero.lead')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="320"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('hero.cta')} /><a class="btn btn-lg v7-btn-ghost" href={mailto} set:html={t('hero.questionnaire')} /></div>
    </div>
<M21 attrs='data-v7-reveal="rise" data-v7-delay="300"' indent={4} />
  </div>
</section>

<section class="v7-sec v7-sec-page" id="touch" aria-labelledby="touch-h">
  <div class="v7-wrap">
    <h2 class="v7-h2" id="touch-h" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('touch.title')} /></span></h2>
    <ul class="v7-sec-touch" data-v7-stagger="100">
      <li class="v7-sec-card" data-v7-reveal>
        <div class="v7-mock v7-sec-stage" data-art="lock" aria-hidden="true" inert>
          <div class="v7-sec-grp">
            <span class="v7-sec-tile v7-sec-locktile"><svg class="v7-sec-lock" viewBox="0 0 24 24"><path class="v7-sec-shackle" d="M8 11V7.5a4 4 0 0 1 8 0V11"/><rect x="5" y="11" width="14" height="10" rx="2.5"/><path d="M12 15.2v1.8"/></svg><i class="v7-sec-ring"></i></span>
            <span class="v7-sec-perms">
              <span class="v7-sec-perm is-read"><svg class="v7-ic" viewBox="0 0 24 24"><path d="M2.5 12S6 5.5 12 5.5 21.5 12 21.5 12 18 18.5 12 18.5 2.5 12 2.5 12z"/><circle cx="12" cy="12" r="2.75"/></svg><span set:html={t('touch.read')} /><i class="v7-sec-yes"><svg class="v7-ic"><use href="#i-check"/></svg></i></span>
              <span class="v7-sec-perm is-write"><svg class="v7-ic" viewBox="0 0 24 24"><path d="M4.5 19.5h4l10-10a2.83 2.83 0 0 0-4-4l-10 10z"/><path d="M13 7l4 4"/></svg><span class="v7-sec-strike" set:html={t('touch.write')} /><i class="v7-sec-no"><svg class="v7-ic"><use href="#i-lock"/></svg></i></span>
            </span>
          </div>
        </div>
        <div class="v7-sec-card-tx">
          <h3 class="v7-sec-card-t" set:html={cards[0].t} />
          <p class="v7-sec-card-p" set:html={cards[0].p} />
        </div>
      </li>
      <li class="v7-sec-card" data-v7-reveal>
        <div class="v7-mock v7-sec-stage" data-art="fields" aria-hidden="true" inert>
          <div class="v7-sec-grp">
            <span class="v7-sec-tile" data-tone="mate"><svg class="v7-ic"><use href="#i-doc"/></svg></span>
            <span class="v7-sec-fields">
              {fields.map((f, i) => (
              <Fragment><span class="v7-sec-field"><b set:html={f} /><i style={`--w:${FIELD_W[i]}`}></i></span>{'\n'}</Fragment>
              ))}
            </span>
          </div>
        </div>
        <div class="v7-sec-card-tx">
          <h3 class="v7-sec-card-t" set:html={cards[1].t} />
          <p class="v7-sec-card-p" set:html={cards[1].p} />
        </div>
      </li>
      <li class="v7-sec-card" data-v7-reveal>
        <div class="v7-mock v7-sec-stage" data-art="approve" aria-hidden="true" inert>
          <div class="v7-sec-grp">
            <span class="v7-sec-draft"><span class="v7-avatar is-mate"><svg class="v7-mark" viewBox="43 43 114 114"><use href="#i-mark"/></svg></span><span class="v7-sec-lines"><i></i><i></i></span></span>
            <span class="v7-sec-wire"><i class="v7-sec-dot"></i></span>
            <span class="v7-sec-tile" data-tone="you"><svg class="v7-ic"><use href="#i-person"/></svg><span class="v7-sec-badge"><svg class="v7-ic"><use href="#i-check"/></svg></span><i class="v7-sec-ring"></i></span>
          </div>
        </div>
        <div class="v7-sec-card-tx">
          <h3 class="v7-sec-card-t" set:html={cards[2].t} />
          <p class="v7-sec-card-p" set:html={cards[2].p} />
        </div>
      </li>
      <li class="v7-sec-card" data-v7-reveal>
        <div class="v7-mock v7-sec-stage" data-art="log" aria-hidden="true" inert>
          <span class="v7-preview-tag v7-sec-tag" set:html={t('touch.example')} />
          <div class="v7-sec-grp">
            <span class="v7-sec-tile"><svg class="v7-ic"><use href="#i-audit"/></svg></span>
            <span class="v7-sec-log"><span class="v7-sec-rows" dir={logDir}>
              {log.map((r, i) => (
              <Fragment><span class:list={['v7-sec-row', { 'is-new': i === log.length - 1 }]} data-tone={i === log.length - 1 ? 'you' : 'mate'}><span class="v7-sec-t">{r.t}</span><b set:html={r.who} /><span set:html={r.what} /></span>{'\n'}</Fragment>
              ))}
            </span></span>
          </div>
        </div>
        <div class="v7-sec-card-tx">
          <h3 class="v7-sec-card-t" set:html={cards[3].t} />
          <p class="v7-sec-card-p" set:html={cards[3].p} />
        </div>
      </li>
    </ul>
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-sec-page" id="before-code" aria-labelledby="before-h">
  <div class="v7-wrap v7-sec-split">
    <div class="v7-sec-copy">
      <h2 class="v7-h2" id="before-h" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('before.title')} /></span></h2>
      <p class="v7-lead" data-v7-reveal data-v7-delay="120" set:html={t('before.lead')} />
    </div>
<M20 indent={4} />
  </div>
</section>

<section class="v7-sec v7-sec-page" id="privacy" aria-labelledby="privacy-h">
  <div class="v7-wrap">
    <h2 class="v7-h2 v7-sec-privh" id="privacy-h" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('privacy.title')} /></span></h2>
    <ul class="v7-check-list v7-sec-checks" data-v7-stagger="80" data-v7-delay="120">
      {checks.map((c) => (
      <Fragment><li data-v7-reveal><Check focusable /><Fragment set:html={c} /></li>{'\n'}</Fragment>
      ))}
    </ul>
    <p class="v7-sec-docline" data-v7-reveal><svg class="v7-ic" aria-hidden="true" focusable="false"><use href="#i-doc"/></svg><span set:html={t('privacy.doc')} /></p>
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-sec-page v7-sec-qsec" id="questionnaire" aria-labelledby="quest-h">
  <div class="v7-wrap">
    <div class="v7-sec-quest" data-v7-reveal>
      <span class="v7-sec-qtile" aria-hidden="true"><svg viewBox="0 0 24 24" focusable="false"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path class="v7-sec-qcheck" d="M8.6 12.1l2.4 2.4 4.5-4.7" pathLength="1"/></svg></span>
      <div class="v7-sec-qcopy">
        <h2 class="v7-sec-qh" id="quest-h" set:html={t('quest.title')} />
        <p set:html={t('quest.p')} />
      </div>
      <a class="v7-link-arrow v7-sec-qlink" href={mailto}><Fragment set:html={t('quest.email')} /><Arrow /></a>
    </div>
  </div>
</section>

<section class="v7-sec v7-band-dark v7-cta v7-pp-cta v7-sec-cta" id="start" aria-labelledby="start-h">
  <div class="v7-wrap">
    <div class="v7-pp-ctacopy" data-v7-stagger="80">
      <h2 id="start-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={startTitle[0]} /></span><span class="v7-line"><span set:html={startTitle[1]} /></span></h2>
      <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={t('start.lead')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="160"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('common:connect')} /></div>
    </div>
  </div>
</section>
</Layout>
