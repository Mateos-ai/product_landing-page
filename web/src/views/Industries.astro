---
// Industries hub (/industries/ and /he/industries/). Port of src/v7/pind/build-hub.py and src/v7/phe/build-hub-he.py.
// Copy: src/i18n/<locale>/industries.json; the closing CTA shares industry.json's ui strings with the industry pages.
// Previews: X2 (the sample goal in each card).
import Layout from '../layouts/Layout.astro';
import Sprite from '../components/v7/Sprite.astro';
import X2 from '../components/v7/X2.astro';
import Arrow from '../components/site/Arrow.astro';
import { pageCtx } from '../i18n/page';
const icon = (id: string) => `<svg class="v7-ic" aria-hidden="true" focusable="false"><use href="#i-${id}"/></svg>`;

const { locale, t, u } = pageCtx(Astro, 'industries');
type Card = { slug: string; tone: string; icon: string; name: string; pain: string; goal: string; hl: string; pillTone: string; pill: string; avatar: string; who: string; sr: string };
type Block = { icon: string; title: string; body: string };
type Fact = { fact: string; label: string };
const sep = t('industry:ui.lineSep');
const mask = (lines: string[], cls: string[] = []) => lines.map((l, i) => `<span class="v7-line${cls[i] ? ' ' + cls[i] : ''}"><span>${l}</span></span>`).join(sep);
const steps = Object.entries(t.raw<Record<string, string>>('steps'));
const cards = t.raw<Card[]>('cards');
const blocks = t.raw<Block[]>('blocks');
const facts = t.raw<Fact[]>('facts');
// The live English hub links to its children as "insurance/"; the Hebrew one spells the full relative path.
const cardHref = (s: string) => (locale === 'en' ? `${s}/` : u(`/industries/${s}/`));
---
<Layout title={t('meta.title')} description={t('meta.description')}>
<Sprite />

<section class="v7-band-dark v7-hero v7-hero--center v7-hub-hero" id="top" aria-labelledby="hero-h1">
  <div class="v7-wrap">
    <div class="v7-pp-hcopy v7-hub-hcopy">
      <span class="eyebrow" data-v7-reveal set:html={t('eyebrow')} />
      <h1 id="hero-h1" class="v7-h1" data-v7-reveal="mask" data-v7-delay="80" set:html={mask(t.raw<string[]>('h1'), ['', 'v7-hub-accent'])} />
      <p class="v7-lead" data-v7-reveal data-v7-delay="300" set:html={t('lead')} />
      <ol class="v7-hub-steps" data-v7-stagger="80">
        {steps.map(([k, s], i) => (
        <Fragment><li data-stage={k} data-v7-reveal data-v7-delay="380"><span class="v7-hub-step"><span class="v7-hub-dot"></span><Fragment set:html={s} /></span>{i < steps.length - 1 && <Fragment set:html={'<svg class="v7-ic v7-ic-flip v7-hub-sep" aria-hidden="true" focusable="false"><use href="#i-arrow"/></svg>'} />}</li>{'\n'}</Fragment>
        ))}
      </ol>
      <p class="v7-micro v7-hub-proof" data-v7-reveal="fade" data-v7-delay="640" set:html={t('proof')} />
    </div>
  </div>
</section>

<section class="v7-sec v7-hub-sec v7-hub-ind" id="industries" aria-labelledby="industries-h">
  <div class="v7-wrap">
    <h2 id="industries-h" class="sr-only" set:html={t('industriesSr')} />
    <div class="v7-hub-gridhead" data-v7-reveal="fade" data-v7-delay="160"><span class="v7-preview-tag" set:html={t('sampleGoals')} /></div>
    <div class="v7-hub-cards" data-v7-stagger="100">
      {cards.map((c) => (<Fragment>
      <a class="v7-hub-card" href={cardHref(c.slug)} data-tone={c.tone} data-v7-reveal>
        <span class="v7-hub-tile" set:html={icon(c.icon)} />
        <div class="v7-hub-head"><h3 class="v7-hub-name" set:html={c.name} /><p class="v7-hub-pain" set:html={c.pain} /></div>
        <X2 tag={t('sampleGoal')} goal={c.goal} hl={c.hl} ph={t('setGoal')} pill={c.pill} pillTone={c.pillTone} avatar={c.avatar} who={c.who} />
        <span class="sr-only" set:html={c.sr} />
        <span class="v7-hub-more"><Fragment set:html={t('seeHow')} /><Arrow /></span>
      </a>{'\n'}</Fragment>
      ))}
    </div>
  </div>
</section>

<section class="v7-sec v7-sec--subtle v7-hub-sec" id="blocks" aria-labelledby="blocks-h">
  <div class="v7-wrap">
    <h2 id="blocks-h" class="v7-h2 v7-hub-h2" data-v7-reveal="mask" set:html={mask(t.raw<string[]>('blocksH2'))} />
    <ul class="v7-hub-blocks" data-v7-stagger="100">
      {blocks.map((b) => (
      <Fragment><li class="v7-hub-block" data-v7-reveal><span class="v7-hub-btile" set:html={icon(b.icon)} /><h3 class="v7-hub-bt" set:html={b.title} /><p class="v7-hub-bl" set:html={b.body} /></li>{'\n'}</Fragment>
      ))}
    </ul>
  </div>
</section>

<section class="v7-sec v7-hub-sec" id="who" aria-labelledby="who-h">
  <div class="v7-wrap">
    <h2 id="who-h" class="v7-h2" data-v7-reveal="mask"><span class="v7-line"><span set:html={t('whoH2')} /></span></h2>
    <ul class="v7-hub-facts" data-v7-stagger="100">
      {facts.map((x) => (
      <Fragment><li data-v7-reveal><span class="v7-hub-fact" set:html={x.fact} /><span class="v7-hub-factl" set:html={x.label} /></li>{'\n'}</Fragment>
      ))}
    </ul>
    <a class="v7-link-arrow v7-hub-hww" href={u('/#how-it-works')} data-v7-reveal><Fragment set:html={t('process')} /><Arrow /></a>
  </div>
</section>

<section class="v7-sec v7-band-dark v7-cta v7-pp-cta" id="start" aria-labelledby="start-h">
  <div class="v7-wrap">
    <div class="v7-pp-ctacopy" data-v7-stagger="80">
      <h2 id="start-h" class="v7-h2" data-v7-reveal="mask" set:html={mask(t.raw<string[]>('industry:ui.moveH2'))} />
      <p class="v7-lead" data-v7-reveal data-v7-delay="160" set:html={t('industry:ui.moveP')} />
      <div class="v7-actions" data-v7-reveal data-v7-delay="160"><a class="btn btn-primary btn-lg" href={u('/contact/')} set:html={t('common:connect')} /></div>
    </div>
  </div>
</section>
</Layout>
