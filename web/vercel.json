{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "cleanUrls": false,
  "redirects": [
    { "source": "/field-stories", "destination": "/industries/", "permanent": true },
    { "source": "/field-stories/", "destination": "/industries/", "permanent": true },
    { "source": "/he/field-stories", "destination": "/he/industries/", "permanent": true },
    { "source": "/he/field-stories/", "destination": "/he/industries/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/(.*)\\.woff2",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(v7\\.css|v7\\.js|site\\.css)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/assets/team/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(favicon\\.ico|favicon\\.svg|logo\\.png|og-v6\\.png)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
